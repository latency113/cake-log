# Copy to .env and fill in real values. NEVER commit real secrets here.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/nvccake
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<64-char-random-hex>
PORT=3001
DB_NAME=nvccake
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=nvccake
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PG_DUMP_PATH=
PSQL_PATH=
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
RESTORE_KEY=<long-random-string>
# CORS_ORIGIN=https://your-frontend-domain
